# Shell scripts and Zig/C sources keep LF everywhere (MSYS sh breaks on
# CRLF inside $(...) captures; see scripts/size_gate.sh PE branch).
*.sh text eol=lf
*.zig text eol=lf
*.c text eol=lf
*.h text eol=lf
*.m text eol=lf
*.rb text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.png binary
*.ttf binary
*.icns binary
